{
  "name": "@joxos/dsh-theme-gallery",
  "version": "1.0.0",
  "description": "DeepSeek Harness bundle that adds a sidebar visual-style gallery with Pixel Arcade and Aurora Whispers themes.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "theme",
    "visual-style",
    "sidebar"
  ],
  "license": "MIT",
  "author": "Joxos <xujunhao61@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joxos/dsh-theme-gallery.git"
  },
  "homepage": "https://github.com/Joxos/dsh-theme-gallery#readme",
  "bugs": {
    "url": "https://github.com/Joxos/dsh-theme-gallery/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/check.mjs",
    "test": "node scripts/smoke-test.mjs",
    "prepack": "node scripts/build-client.mjs && node scripts/check.mjs && node scripts/smoke-test.mjs",
    "prepublishOnly": "node scripts/check-publish.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
